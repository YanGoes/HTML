    <script>
function direcao(carouselId, e) {
    const carousel = document.getElementById(carouselId);

    if (e === 1) {
        // Rola para a esquerda
        carousel.scrollLeft -= 200;
    } else if (e === 2) {
        // Rola para a direita
        carousel.scrollLeft += 200;
    }
}

// Adiciona o evento de rolagem com o mouse para cada carrossel por ID
document.getElementById('carousel-series').addEventListener('wheel', (event) => {
    event.preventDefault();
    if (event.deltaY < 0) {
        direcao('carousel-series', 1); // Rolagem para a esquerda
    } else {
        direcao('carousel-series', 2); // Rolagem para a direita
    }
});

document.getElementById('carousel-filmes').addEventListener('wheel', (event) => {
    event.preventDefault();
    if (event.deltaY < 0) {
        direcao('carousel-filmes', 1); // Rolagem para a esquerda
    } else {
        direcao('carousel-filmes', 2); // Rolagem para a direita
    }
});

</script>
