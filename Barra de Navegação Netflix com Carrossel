/* Novo estilo do carrossel */
.contentSlide {
position: relative;
width: 100%;
height: 260px;
overflow-x: auto;
overflow-y: hidden;
scroll-behavior: smooth;
white-space: nowrap;
padding: 50px;
}

.contentSlide::-webkit-scrollbar {
display: none;
}

.contentSlide .block:hover {
    border: 3px solid white; /* Borda branca ao passar o mouse */
    box-shadow: 0 4px 20px rgba(255, 255, 255, 0.5); /* Sombra suave */
    transform: scale(1.05); /* Aumenta levemente a imagem */
    transition: all 0.3s ease; /* Transição suave */
}

.contentSlide .block {
display: inline-block;
width: 300px;
height: 300px cover;
margin-right: -4.5px;
background-color: #333;
border-radius: 5px;
}

.contentSlide .block img {
width: 100%; /* Imagem ocupa toda a largura do bloco */
height: auto; /* Imagem ocupa toda a altura do bloco */
object-fit: cover; /* Mantém a proporção da imagem */
}

.custom-bg {
background-color: #b2af07; /* Insira a cor desejada */
}

/* Estilos para o dropdown */
.dropdown {
position: relative;
display: inline-block;
margin-right: 15px;
}

.dropbtn {
background-color: #ff000000;
color: white;
padding: 10px 20px;
font-size: 16px;
border: none;
cursor: pointer;
border-radius: 4px;
}

.custom-bg {
background-color: rgba(255, 0, 0, 0);; /* Insira a cor desejada */
}

.dropdown-content {
display: none;
text-decoration: none;
position: absolute;
background-color: #333;
min-width: 160px;
box-shadow: 0px 8px 16px 0px rgb(255, 0, 0);
z-index: 1;
border-radius: 4px;
}

.dropdown-content a {
color: white;
padding: 12px 16px;
text-decoration: none;
display: block;
}

.dropdown-content a:hover {
background-color: #575757;
text-decoration: none;
color:white
}

.dropbtn:hover {
    text-decoration: none;
    color: white; /* Ou outra cor desejada para o hover */
}

.dropdown:hover .dropdown-content {
display: block;
}

.dropdown:hover .dropbtn {
background-color: #b20710;
text-decoration: none;
}
